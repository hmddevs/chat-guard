# Copy to .env and fill in your own values. Never commit .env.

# Discord bot token, from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# MongoDB connection string
MONGODB_URI=

# Discord user IDs who are bot owners, comma-separated
BOT_OWNERS=

# Optional: status message shown by the bot (defaults to "Bot is online!")
BOT_STATUS=
